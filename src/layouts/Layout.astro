---
import '../styles/global.css';
import UniversityHeader from '../components/UniversityHeader.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "UOS Entrepreneurship Society | University of Sahiwal",
  description = "The official student-led entrepreneurship and innovation chapter at the University of Sahiwal, uniting Computing, Management Sciences, and Humanities."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://github.com/uos-entrepreneurship" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased selection:bg-blue-900 selection:text-white min-h-screen flex flex-col">
    <!-- University Affiliation Header Bar -->
    <UniversityHeader />

    <slot />

    <!-- Lenis Smooth Scroll -->
    <script>
      import { initSmoothScroll } from '../scripts/lenis';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initSmoothScroll());
      } else {
        initSmoothScroll();
      }
    </script>
  </body>
</html>
