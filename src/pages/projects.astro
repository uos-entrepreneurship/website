---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import UniversityFooter from '../components/UniversityFooter.astro';
import { projects } from '../data/projects';
import { ExternalLink, Rocket, Code2, Users, ArrowUpRight } from 'lucide-react';
import GitHubIcon from '../components/GitHubIcon.astro';
---

<Layout
  title="Member Projects & Blueprints | UOS Entrepreneurship Society"
  description="Explore software, open-source toolkits, and startup prototypes engineered by students at the University of Sahiwal."
>
  <Navbar client:load currentPath="/projects" />

  <main class="flex-grow py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl mb-14">
      <span class="text-xs font-mono font-bold tracking-widest uppercase text-blue-900 bg-blue-50 border border-blue-200 px-3 py-1 rounded-full">
        Proof of Work
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight mt-3 mb-4">
        What We’ve Actually Built
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        We answer one fundamental question: <em>Does this society actually build things, or just talk?</em> Here is our public registry of member projects, developer toolkits, and student ventures.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {projects.map((proj) => (
        <div class="bg-white border border-slate-200 rounded-3xl p-7 shadow-sm hover:border-slate-300 transition-all flex flex-col justify-between">
          <div>
            {/* Status & Category Badge */}
            <div class="flex items-center justify-between mb-4">
              <span class={`text-[10px] font-mono px-2.5 py-0.5 rounded-full font-bold uppercase ${
                proj.status === 'Launched'
                  ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                  : proj.status === 'Prototype'
                  ? 'bg-amber-50 text-amber-800 border border-amber-200'
                  : 'bg-blue-50 text-blue-800 border border-blue-200'
              }`}>
                {proj.status}
              </span>

              <span class="text-xs font-mono text-slate-400">
                {proj.category}
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-1.5">
              {proj.name}
            </h3>

            <p class="text-xs font-mono text-blue-950 font-semibold mb-3">
              {proj.tagline}
            </p>

            <p class="text-xs text-slate-600 leading-relaxed mb-6">
              {proj.description}
            </p>

            {/* Tech Stack Pills */}
            <div class="flex flex-wrap gap-1.5 mb-6">
              {proj.techStack.map((tech) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-100 text-slate-700">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 space-y-3">
            {/* Team Members */}
            <div class="flex items-center justify-between text-xs text-slate-500 font-mono">
              <div class="flex items-center gap-1.5">
                <Users class="w-3.5 h-3.5 text-slate-400" />
                <span>{proj.team.map((t) => t.name).join(', ')}</span>
              </div>
            </div>

            {/* Action Links */}
            <div class="flex items-center gap-3 pt-1">
              {proj.links.github && (
                <a
                  href={proj.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-slate-900 hover:text-blue-900"
                >
                  <GitHubIcon class="w-3.5 h-3.5" />
                  <span>Repository</span>
                  <ArrowUpRight class="w-3 h-3 text-slate-400" />
                </a>
              )}

              {proj.links.demo && (
                <a
                  href={proj.links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-emerald-700 hover:underline"
                >
                  <span>Live Demo</span>
                  <ExternalLink class="w-3 h-3" />
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Submit Project Banner -->
    <div class="bg-slate-900 text-white rounded-3xl p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
      <div class="space-y-2 max-w-xl">
        <h3 class="text-xl font-bold text-white">
          Building a project on campus?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Whether it is an open-source tool, an academic final-year project, or a commercial SaaS startup, we will showcase it here and connect you with beta testers and mentors.
        </p>
      </div>

      <a
        href="/join"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-xs text-slate-950 bg-amber-400 hover:bg-amber-300 transition-colors shrink-0"
      >
        <span>Submit a Project</span>
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
    </div>
  </main>

  <UniversityFooter />
</Layout>
