---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import Marquee from '../components/Marquee.astro';
import Mission from '../components/Mission.astro';
import Pillars from '../components/Pillars';
import Programs from '../components/Programs.astro';
import Stats from '../components/Stats';
import Roadmap from '../components/Roadmap.astro';
import Team from '../components/Team.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Global sticky navbar -->
  <Navbar client:load />

  <main class="flex-grow">
    <!-- Hero Section -->
    <Hero client:load />

    <!-- Infinite Marquee Ticker -->
    <Marquee />

    <!-- Mission & Institutional Purpose -->
    <Mission />

    <!-- Five Strategic Pillars Bento Grid -->
    <Pillars client:visible />

    <!-- Flagship Programs -->
    <Programs />

    <!-- Target Impact Stats -->
    <Stats client:visible />

    <!-- Interactive Execution Roadmap -->
    <Roadmap />

    <!-- Team Leadership & Governance -->
    <Team />

    <!-- Final Call to Action -->
    <CTA />
  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
