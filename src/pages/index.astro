---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import AboutMandate from '../components/AboutMandate.astro';
import Pillars from '../components/Pillars';
import FlagshipPrograms from '../components/FlagshipPrograms.astro';
import CalendarSchedule from '../components/CalendarSchedule.astro';
import Governance from '../components/Governance.astro';
import OpenSyllabi from '../components/OpenSyllabi.astro';
import InstitutionalCTA from '../components/InstitutionalCTA.astro';
import UniversityFooter from '../components/UniversityFooter.astro';
---

<Layout>
  <!-- Institutional Sticky Navbar -->
  <Navbar client:load />

  <main class="flex-grow">
    <!-- Academic Hero Section -->
    <Hero client:load />

    <!-- Mandate & Faculty Linkage -->
    <AboutMandate />

    <!-- Five Strategic Pillars -->
    <Pillars client:visible />

    <!-- Flagship Cohorts & Hands-on Lab Bootcamps -->
    <FlagshipPrograms />

    <!-- Academic Semester Calendar -->
    <CalendarSchedule />

    <!-- Governance: Faculty Advisory & Executive Cabinet -->
    <Governance />

    <!-- Public Documentation & Open GitHub Blueprints -->
    <OpenSyllabi />

    <!-- Official Student Membership Admissions -->
    <InstitutionalCTA />
  </main>

  <!-- University Footer -->
  <UniversityFooter />
</Layout>
