---
import { GraduationCap, ArrowRight, Mail, CheckCircle2, ShieldCheck, FileCheck } from 'lucide-react';
---

<section id="membership" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white rounded-3xl p-8 sm:p-14 lg:p-16 shadow-xl relative overflow-hidden border border-slate-800">
    <!-- Subtle architectural grid in background -->
    <div class="absolute inset-0 bg-grid-subtle opacity-5 pointer-events-none" />

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-300 font-mono text-xs font-semibold uppercase tracking-wider mb-6">
        <ShieldCheck class="w-3.5 h-3.5" />
        <span>Spring 2027 Cohort Admissions</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4">
        Apply to Join the University of Sahiwal Entrepreneurship Society
      </h2>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-8">
        Membership gives you direct access to technical bootcamps in university labs, venture incubation mentorship, the GitHub Student Developer Pack verification clinics, and our intra-campus hackathons.
      </p>

      <!-- Checklist of Membership Guarantees -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10 text-xs text-slate-200">
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Zero membership fees (100% University Student-Led)</span>
        </div>
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Open to all academic departments & faculties</span>
        </div>
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Hands-on computing lab access for workshops</span>
        </div>
        <div class="flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
          <span>Official society Certificate of Completion</span>
        </div>
      </div>

      <!-- Action Row -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href="mailto:ashiriftikharofficial@gmail.com?subject=UOS%20Entrepreneurship%20Society%20-%20Membership%20Application&body=Name:%0D%0ARoll%20Number:%0D%0ADepartment%20(e.g.%20CS,%20BBA,%20English):%0D%0ASemester:%0D%0AWhy%20do%20you%20want%20to%20join%20the%20society?:"
          class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl font-bold text-sm text-slate-950 bg-amber-400 hover:bg-amber-300 shadow-md hover:shadow-lg transition-all"
        >
          <span>Submit Membership Application</span>
          <ArrowRight class="w-4 h-4" />
        </a>

        <a
          href="https://github.com/uos-entrepreneurship"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl font-semibold text-xs font-mono text-slate-300 bg-white/5 hover:bg-white/10 border border-white/10 transition-colors"
        >
          <span>Star & Follow on GitHub</span>
        </a>
      </div>

      <!-- Institutional Contact Footnote -->
      <div class="pt-8 mt-10 border-t border-white/10 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-400 font-mono">
        <span class="flex items-center gap-1.5">
          <Mail class="w-3.5 h-3.5 text-amber-400" />
          ashiriftikharofficial@gmail.com
        </span>
        <span>•</span>
        <span>Farid Town Road, Sahiwal, Punjab, Pakistan</span>
      </div>
    </div>
  </div>
</section>
