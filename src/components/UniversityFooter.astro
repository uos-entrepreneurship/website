---
import { ExternalLink, Mail, MapPin } from 'lucide-react';
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      <!-- Col 1: Crest & Affiliation (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-slate-950 border border-amber-500/80 flex items-center justify-center font-mono font-bold text-amber-400 text-sm">
            UOS
          </div>
          <div>
            <span class="font-extrabold text-white text-base block tracking-tight">
              UOS Entrepreneurship Society
            </span>
            <span class="text-xs font-mono text-slate-400">
              University of Sahiwal
            </span>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          A conversion-focused, student-led operating system turning campus ideas into real software, projects, and ventures. Operating under the Directorate of Student Affairs.
        </p>

        <div class="pt-2 text-[11px] font-mono text-amber-300">
          ENTREPRENEURSHIP • INNOVATION • TECHNOLOGY
        </div>
      </div>

      <!-- Col 2: Navigation Hub -->
      <div class="space-y-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-white block">
          Pages
        </span>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/" class="hover:text-amber-300 transition-colors">Home</a></li>
          <li><a href="/events" class="hover:text-amber-300 transition-colors">Events & Workshops</a></li>
          <li><a href="/projects" class="hover:text-amber-300 transition-colors">Member Projects</a></li>
          <li><a href="/about" class="hover:text-amber-300 transition-colors">About & Team</a></li>
          <li><a href="/join" class="hover:text-amber-300 transition-colors font-bold text-white">Join the Society</a></li>
        </ul>
      </div>

      <!-- Col 3: Open Resources -->
      <div class="space-y-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-white block">
          Open Resources
        </span>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="https://github.com/uos-entrepreneurship"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-amber-300 transition-colors flex items-center gap-1.5"
            >
              <span>GitHub Organization Hub</span>
              <ExternalLink class="w-3 h-3 text-slate-500" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/uos-entrepreneurship/website"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-amber-300 transition-colors flex items-center gap-1.5"
            >
              <span>Web Portal Code</span>
              <ExternalLink class="w-3 h-3 text-slate-500" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/uos-entrepreneurship/.github/blob/main/WORKSHOP_SERIES_GIT_ZERO_TO_HERO.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-amber-300 transition-colors flex items-center gap-1.5"
            >
              <span>Git Workshop Syllabus</span>
              <ExternalLink class="w-3 h-3 text-slate-500" />
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="hover:text-amber-300 transition-colors block text-slate-400"
            >
              Student Privacy Policy
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Campus Office -->
      <div class="space-y-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-white block">
          Campus Office
        </span>
        <div class="text-xs space-y-2 text-slate-400">
          <p class="text-slate-200 font-semibold">University of Sahiwal</p>
          <p class="flex items-start gap-1.5">
            <MapPin class="w-3.5 h-3.5 text-slate-400 mt-0.5 shrink-0" />
            <span>Farid Town Road, Sahiwal, Punjab, Pakistan</span>
          </p>
          <a
            href="mailto:ashiriftikharofficial@gmail.com"
            class="text-amber-400 hover:underline block font-mono text-[11px] pt-1"
          >
            ashiriftikharofficial@gmail.com
          </a>
          <a
            href="https://uosahiwal.edu.pk"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-slate-200 block text-[11px] pt-1 flex items-center gap-1"
          >
            <span>uosahiwal.edu.pk</span>
            <ExternalLink class="w-3 h-3" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
      <div>
        © 2026 UOS Entrepreneurship Society. Chartered under Directorate of Student Affairs, University of Sahiwal.
      </div>

      <div>
        <a href="/privacy" class="hover:underline text-slate-400 mr-4">Privacy Policy</a>
        <span>Open Source MIT</span>
      </div>
    </div>
  </div>
</footer>
