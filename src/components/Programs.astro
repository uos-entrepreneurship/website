---
import { Code, Flame, Trophy, Mic2, ArrowRight, Calendar, Sparkles } from 'lucide-react';

const programs = [
  {
    title: "Workshop: 'Git & GitHub Zero to Hero'",
    category: "Developer Tooling",
    icon: Code,
    duration: "2-Hour Intensive",
    description: "A battle-tested curriculum taking absolute beginners from terminal setup to making their first open-source Pull Request and unlocking the GitHub Student Developer Pack.",
    features: [
      "Local Git & SSH setup with zero jargon",
      "Branching, merge conflict resolution & PR etiquette",
      "Manual Student Pack verification walkthrough",
      "Immediate merged PR certificate of completion"
    ],
    tag: "Flagship Bootcamp",
    status: "Active Registration"
  },
  {
    title: "Venture Incubation Pipeline",
    category: "Startup Accelerator",
    icon: Flame,
    duration: "8-Week Sprint",
    description: "From napkin idea to deployed MVP. Pairs multidisciplinary student founders (business + engineering + design) with working mentors to build viable commercial solutions.",
    features: [
      "Customer problem validation & interviewing",
      "No-code / low-code & custom stack rapid builds",
      "Financial projections & unit economics",
      "Final Pitch Day in front of founders & alumni"
    ],
    tag: "Venture Track",
    status: "Upcoming Cohort"
  },
  {
    title: "The UOS Intra-Campus Hackathon",
    category: "Campus Competition",
    icon: Trophy,
    duration: "48 Hours",
    description: "The flagship annual software and business competition bringing together 150+ students from all departments to build solutions for regional and global challenges.",
    features: [
      "Cross-department team matchmaking",
      "Real-time technical mentor office hours",
      "Cash prizes, cloud credits & incubation fast-tracks",
      "Live product demonstrations to industry judges"
    ],
    tag: "Campus Marquee",
    status: "Scheduled Q3"
  },
  {
    title: "Founder Firesides & Agency Playbooks",
    category: "Speaker Series",
    icon: Mic2,
    duration: "Monthly Sessions",
    description: "Unfiltered, actionable talks with software agency founders, freelance consultants, and senior engineers sharing tactical lessons on client acquisition and remote work.",
    features: [
      "Cold outreach & international freelance contracts",
      "Transitioning from student to high-earning builder",
      "Direct Q&A and private CV review sessions",
      "Local networking with practicing tech leads"
    ],
    tag: "Industry Access",
    status: "Monthly Event"
  }
];
---

<section id="programs" class="relative py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/20 text-emerald-400 font-mono text-xs uppercase tracking-widest mb-4">
        <Sparkles class="w-3.5 h-3.5 text-emerald-400" />
        <span>Actionable Initiatives</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
        Flagship Programs
      </h2>
      <p class="text-sm sm:text-base text-gray-400 mt-3 leading-relaxed">
        Structured bootcamps, competitions, and masterclasses designed to generate tangible outputs—not just certificates of attendance.
      </p>
    </div>

    <a
      href="https://github.com/uos-entrepreneurship/.github/blob/main/WORKSHOP_SERIES_GIT_ZERO_TO_HERO.md"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors pb-1 border-b border-emerald-400/30 hover:border-emerald-300 w-fit"
    >
      <span>Inspect Workshop Blueprint</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {programs.map((prog) => {
      const Icon = prog.icon;
      return (
        <div class="glass-panel rounded-3xl p-8 hover:border-emerald-500/40 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-gray-900 border border-white/10 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition-transform">
                <Icon class="w-6 h-6" />
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-white/5 border border-white/5 text-gray-400">
                  {prog.duration}
                </span>
                <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 font-medium">
                  {prog.tag}
                </span>
              </div>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
              {prog.title}
            </h3>

            <p class="text-sm text-gray-300 leading-relaxed mb-6">
              {prog.description}
            </p>

            <div class="space-y-2 mb-8">
              {prog.features.map((feat) => (
                <div class="flex items-center gap-2 text-xs text-gray-400">
                  <span class="w-1 h-1 rounded-full bg-emerald-400"></span>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-white/5 flex items-center justify-between">
            <span class="text-xs font-mono text-gray-400 flex items-center gap-1.5">
              <Calendar class="w-3.5 h-3.5 text-emerald-400" />
              {prog.status}
            </span>

            <a
              href="#get-involved"
              class="text-xs font-medium text-white hover:text-emerald-400 flex items-center gap-1 group-hover:translate-x-1 transition-all"
            >
              <span>Join Program</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      );
    })}
  </div>
</section>
