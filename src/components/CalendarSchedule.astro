---
import { Calendar, Clock, MapPin, CheckCircle2, AlertCircle } from 'lucide-react';

const events = [
  {
    date: "November 25, 2026",
    time: "02:00 PM - 04:00 PM",
    title: "Official Society Orientation & Executive Mixer",
    venue: "Main Auditorium, Academic Block",
    category: "Campus General",
    speaker: "Executive Council & Faculty Patrons",
    status: "Confirmed",
    openTo: "All Departments (CS, BBA, Law, English, Sciences)"
  },
  {
    date: "December 05, 2026",
    time: "10:00 AM - 12:30 PM",
    title: "Workshop: 'Git & GitHub Ground Zero to First PR'",
    venue: "CS Computing Lab 1, Department of CS",
    category: "Technical Bootcamp",
    speaker: "Ashar Iftikhar & Tech Leads",
    status: "Registration Open",
    openTo: "Undergraduate Students (Limited to 60 seats)"
  },
  {
    date: "December 18, 2026",
    time: "02:30 PM - 04:30 PM",
    title: "Case Study Clinic: 'Customer Discovery & Zero-Capital MVPs'",
    venue: "Video Conference Room, Admin Block",
    category: "Venture Track",
    speaker: "Management Sciences Advisory & Guest Founders",
    status: "Confirmed",
    openTo: "BBA & CS Cross-Disciplinary Teams"
  },
  {
    date: "January 15, 2027",
    time: "03:00 PM - 05:00 PM",
    title: "Founder Masterclass: 'Remote Agency Contracts & High-Value Freelancing'",
    venue: "Academic Block A / Hybrid Livestream",
    category: "Industry Series",
    speaker: "Practicing Full-Stack Founders & Alumni",
    status: "Upcoming",
    openTo: "Open Campus & Public"
  },
  {
    date: "February 20-22, 2027",
    time: "48-Hour Weekend",
    title: "The Annual UOS 48-Hour Intra-Campus Hackathon",
    venue: "University Main Auditorium & CS Labs",
    category: "Marquee Competition",
    speaker: "Industry Mentors, Academic Judges & Tech Sponsors",
    status: "Planning",
    openTo: "Registered 3-to-4 Member Student Teams"
  }
];
---

<section id="schedule" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
    <div>
      <span className="text-xs font-mono font-bold tracking-widest uppercase text-blue-900 bg-blue-50 border border-blue-200 px-3 py-1 rounded-full">
        Academic Term 2026–2027
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-3">
        Campus Event Calendar
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Regularly scheduled masterclasses, lab bootcamps, and hackathons conducted across campus facilities.
      </p>
    </div>

    <div class="flex items-center gap-2 text-xs font-mono text-slate-500 bg-white border border-slate-200 px-3 py-2 rounded-lg shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse" />
      <span>All events held on-campus at University of Sahiwal</span>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="bg-slate-100/80 border-b border-slate-200 font-mono text-xs text-slate-700">
            <th class="py-3.5 px-5 font-semibold">Date & Time</th>
            <th class="py-3.5 px-5 font-semibold">Event / Workshop</th>
            <th class="py-3.5 px-5 font-semibold">Campus Venue</th>
            <th class="py-3.5 px-5 font-semibold">Track</th>
            <th class="py-3.5 px-5 font-semibold">Target Audience</th>
            <th class="py-3.5 px-5 font-semibold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {events.map((ev) => (
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="py-4 px-5 whitespace-nowrap">
                <span class="font-bold text-slate-900 block font-mono text-xs">{ev.date}</span>
                <span class="text-[11px] text-slate-500 font-mono">{ev.time}</span>
              </td>
              <td class="py-4 px-5">
                <span class="font-bold text-slate-900 block">{ev.title}</span>
                <span class="text-xs text-slate-500">Lead: {ev.speaker}</span>
              </td>
              <td class="py-4 px-5 whitespace-nowrap text-xs text-slate-600">
                <div class="flex items-center gap-1.5 font-mono">
                  <MapPin class="w-3.5 h-3.5 text-slate-400" />
                  <span>{ev.venue}</span>
                </div>
              </td>
              <td class="py-4 px-5 whitespace-nowrap">
                <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-800 font-medium">
                  {ev.category}
                </span>
              </td>
              <td class="py-4 px-5 text-xs text-slate-600">
                {ev.openTo}
              </td>
              <td class="py-4 px-5 whitespace-nowrap">
                <span class={`text-[11px] font-mono font-semibold px-2.5 py-1 rounded-full ${
                  ev.status === "Registration Open"
                    ? "bg-emerald-50 text-emerald-800 border border-emerald-200"
                    : ev.status === "Confirmed"
                    ? "bg-blue-50 text-blue-800 border border-blue-200"
                    : "bg-slate-100 text-slate-700 border border-slate-200"
                }`}>
                  {ev.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
