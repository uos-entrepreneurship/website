---
import { Code2, Flame, Trophy, Mic2, MapPin, Clock, ArrowRight, ExternalLink } from 'lucide-react';

const programs = [
  {
    title: "Workshop: 'Git & GitHub Ground Zero to First PR'",
    track: "Technical Tooling",
    icon: Code2,
    venue: "CS Computing Lab 1, Academic Block",
    duration: "2-Hour Practical Session",
    audience: "All Departments (Absolute Beginners)",
    summary: "A rigorous, hands-on masterclass teaching students how to configure Git, authenticate securely via SSH, open a feature branch, and submit their first Pull Request onto the society repository.",
    curriculum: [
      "Local Git terminal config & SSH key generation",
      "Branch isolation, atomic commits & merge requests",
      "Manual GitHub Student Developer Pack verification guide",
      "Automated pull request merge & certificate issue"
    ],
    status: "Upcoming Session",
    docLink: "https://github.com/uos-entrepreneurship/.github/blob/main/WORKSHOP_SERIES_GIT_ZERO_TO_HERO.md"
  },
  {
    title: "The UOS 8-Week Venture Incubation Cohort",
    track: "Startup Accelerator",
    icon: Flame,
    venue: "Video Conference Room / Incubation Suite",
    duration: "8-Week Guided Sprint",
    audience: "Selected Student Teams (CS x BBA)",
    summary: "A structured pre-seed acceleration program pairing engineering students with business strategists to take a problem statement from customer discovery to a live deployable MVP with financial unit economics.",
    curriculum: [
      "Week 1-2: Problem validation & 20+ user interviews",
      "Week 3-4: Low-code / full-stack rapid MVP builds",
      "Week 5-6: Unit economics, pricing & distribution models",
      "Week 7-8: Pitch deck crafting & Demo Day presentation"
    ],
    status: "Spring 2027 Applications",
    docLink: null
  },
  {
    title: "The Annual UOS Intra-Campus Hackathon",
    track: "Campus Competition",
    icon: Trophy,
    venue: "University Main Auditorium",
    duration: "48-Hour Continuous Marathon",
    audience: "150+ Multidisciplinary Students",
    summary: "The flagship annual innovation competition challenging student teams to prototype software solutions for regional governance, education, healthcare, and enterprise automation with cash grants and industry judges.",
    curriculum: [
      "Cross-department team matchmaking and team formation",
      "24-hour technical mentor office hours and code reviews",
      "Live 3-minute stage demo in front of industry founders",
      "Fast-track entry into regional startup accelerators"
    ],
    status: "Annual Q3 Event",
    docLink: null
  },
  {
    title: "CEO & Founder Masterclass Series",
    track: "Executive Exposure",
    icon: Mic2,
    venue: "Academic Block A / Online Hybrid",
    duration: "Monthly 90-Min Sessions",
    audience: "Open Campus Attendance",
    summary: "Unfiltered, actionable discussions with practicing software agency owners, remote engineers, and tech founders sharing transparent operational playbooks on international freelancing, client acquisition, and career mobility.",
    curriculum: [
      "Closing high-value international software contracts",
      "How to convert university projects into commercial portfolios",
      "Direct CV & portfolio reviews from senior engineers",
      "Interactive Q&A on navigating remote global employment"
    ],
    status: "Monthly Calendar",
    docLink: null
  }
];
---

<section id="programs" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto bg-slate-50 border-y border-slate-200">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
    <div class="max-w-2xl">
      <span className="text-xs font-mono font-bold tracking-widest uppercase text-blue-900 bg-blue-100 border border-blue-200 px-3 py-1 rounded-full">
        Hands-on Delivery
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-3">
        Flagship Programs & Cohorts
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
        Concrete learning tracks conducted in physical campus facilities with documented syllabi and measurable student outcomes.
      </p>
    </div>

    <a
      href="https://github.com/uos-entrepreneurship/.github/blob/main/WORKSHOP_SERIES_GIT_ZERO_TO_HERO.md"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-blue-900 font-semibold hover:underline"
    >
      <span>Inspect Workshop Curriculum (Markdown)</span>
      <ExternalLink class="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {programs.map((prog) => {
      const Icon = prog.icon;
      return (
        <div class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm hover:border-slate-300 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-800">
                  <Icon class="w-5 h-5" />
                </div>
                <div>
                  <span class="text-[11px] font-mono uppercase tracking-wider text-blue-900 font-bold block">
                    {prog.track}
                  </span>
                  <span class="text-xs text-slate-500 font-mono">
                    {prog.duration}
                  </span>
                </div>
              </div>

              <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 font-semibold">
                {prog.status}
              </span>
            </div>

            <h3 class="text-xl font-bold text-slate-900 mb-2">
              {prog.title}
            </h3>

            <div class="flex flex-wrap items-center gap-y-1 gap-x-4 text-xs font-mono text-slate-500 mb-4 pb-3 border-b border-slate-100">
              <span class="flex items-center gap-1">
                <MapPin class="w-3.5 h-3.5 text-slate-400" />
                {prog.venue}
              </span>
              <span>•</span>
              <span>{prog.audience}</span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
              {prog.summary}
            </p>

            <div class="space-y-2 mb-6 bg-slate-50 p-4 rounded-xl border border-slate-100">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 font-bold block mb-1">
                Curriculum Structure:
              </span>
              {prog.curriculum.map((item) => (
                <div class="flex items-start gap-2 text-xs text-slate-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-700 mt-1.5 shrink-0" />
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            {prog.docLink ? (
              <a
                href={prog.docLink}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono text-blue-900 hover:text-blue-700 font-semibold flex items-center gap-1"
              >
                <span>Read Full Lesson Plan</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            ) : (
              <span class="text-xs font-mono text-slate-400">
                Curriculum syllabus released prior to cohort
              </span>
            )}

            <a
              href="#membership"
              class="px-4 py-2 rounded-lg text-xs font-bold text-white bg-slate-900 hover:bg-blue-950 transition-colors"
            >
              Enroll
            </a>
          </div>
        </div>
      );
    })}
  </div>
</section>
