---
import { Mail, Globe, ArrowUpRight, Heart } from 'lucide-react';
---

<footer class="relative bg-gray-950 border-t border-white/5 pt-16 pb-12 px-4 sm:px-6 lg:px-8 text-gray-400">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/5">
      <!-- Col 1: Brand (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-800 p-0.5">
            <div class="w-full h-full bg-gray-950 rounded-[10px] flex items-center justify-center font-mono text-emerald-400 font-bold text-base">
              ES
            </div>
          </div>
          <div>
            <span class="font-bold text-white text-base block tracking-tight">
              UOS Entrepreneurship Society
            </span>
            <span class="text-xs font-mono text-gray-500 uppercase tracking-wider">
              University of Sahiwal
            </span>
          </div>
        </div>

        <p class="text-xs text-gray-400 leading-relaxed max-w-sm">
          A cross-disciplinary, student-led collective empowering every department to build modern software, master founder skills, and create real ventures.
        </p>

        <div class="pt-2">
          <span class="inline-block text-[11px] font-mono tracking-widest uppercase text-emerald-400/90 font-medium">
            Think. Build. Launch.
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-white block">
          Navigation
        </span>
        <ul class="space-y-2 text-xs">
          <li><a href="#mission" class="hover:text-emerald-400 transition-colors">Mission & Purpose</a></li>
          <li><a href="#pillars" class="hover:text-emerald-400 transition-colors">Five Strategic Pillars</a></li>
          <li><a href="#programs" class="hover:text-emerald-400 transition-colors">Flagship Programs</a></li>
          <li><a href="#roadmap" class="hover:text-emerald-400 transition-colors">Execution Roadmap</a></li>
          <li><a href="#team" class="hover:text-emerald-400 transition-colors">Core Leadership</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div class="space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-white block">
          Open Resources
        </span>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="https://github.com/uos-entrepreneurship"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors flex items-center gap-1"
            >
              <span>GitHub Organization</span>
              <ArrowUpRight class="w-3 h-3 text-gray-500" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/uos-entrepreneurship/.github/blob/main/WORKSHOP_SERIES_GIT_ZERO_TO_HERO.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors flex items-center gap-1"
            >
              <span>Git Workshop Curriculum</span>
              <ArrowUpRight class="w-3 h-3 text-gray-500" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/uos-entrepreneurship/.github/blob/main/CAMPUS_EXPERT_PORTFOLIO.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors flex items-center gap-1"
            >
              <span>Campus Expert Framework</span>
              <ArrowUpRight class="w-3 h-3 text-gray-500" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/uos-entrepreneurship/.github/blob/main/.github/CODE_OF_CONDUCT.md"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors flex items-center gap-1"
            >
              <span>Code of Conduct</span>
              <ArrowUpRight class="w-3 h-3 text-gray-500" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contact & Campus -->
      <div class="space-y-3">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-white block">
          Institutional
        </span>
        <div class="text-xs space-y-2 text-gray-400">
          <p class="text-gray-300">University of Sahiwal</p>
          <p>Sahiwal, Punjab, Pakistan</p>
          <a
            href="mailto:ashiriftikharofficial@gmail.com"
            class="text-emerald-400 hover:text-emerald-300 block font-mono text-[11px] pt-1"
          >
            ashiriftikharofficial@gmail.com
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom credit line -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-gray-500">
      <div>
        © 2026 UOS Entrepreneurship Society. All open-source assets licensed under MIT.
      </div>

      <div class="flex items-center gap-1">
        <span>Architected with</span>
        <Heart class="w-3.5 h-3.5 text-emerald-400 fill-emerald-400" />
        <span>by students at University of Sahiwal</span>
      </div>
    </div>
  </div>
</footer>
