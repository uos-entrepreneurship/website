---
import { CheckCircle2, Clock, MapPin, Milestone } from 'lucide-react';

const phases = [
  {
    phase: "Phase 01",
    timeline: "Quarter 1",
    status: "In Progress",
    statusColor: "emerald",
    title: "Community Infrastructure & Launch",
    focus: "Formalizing society presence and onboarding the first student developer wave.",
    milestones: [
      "Official GitHub Organization launch & profile deployment",
      "Executive organizing committee and department lead recruitment",
      "First campus-wide 'Git & GitHub Zero to Hero' workshop delivery",
      "Student Developer Pack manual verification clinic"
    ]
  },
  {
    phase: "Phase 02",
    timeline: "Quarter 2",
    status: "Upcoming",
    statusColor: "cyan",
    title: "Applied Technical Sprints & Open Source",
    focus: "Bridging classroom coding to collaborative industry-standard version control.",
    milestones: [
      "4-Week Full-Stack & AI application sprint",
      "Campus-wide first contribution drive (30+ student PRs merged)",
      "Cross-department founder ideation mixers (BBA x CS teams)",
      "Technical mentorship pairs for junior students"
    ]
  },
  {
    phase: "Phase 03",
    timeline: "Quarter 3",
    status: "Planned",
    statusColor: "teal",
    title: "Momentum & Intra-Campus Hackathon",
    focus: "Testing velocity, team dynamics, and pitch delivery under pressure.",
    milestones: [
      "First annual 48-Hour UOS Intra-Campus Hackathon",
      "Keynote speaker series featuring industry agency founders",
      "Student pitch polish and commercial MVP evaluations",
      "Sponsorship agreements with regional tech ecosystems"
    ]
  },
  {
    phase: "Phase 04",
    timeline: "Quarter 4",
    status: "Planned",
    statusColor: "purple",
    title: "Venture Showcase & Talent Transition",
    focus: "Demonstrating commercial viability and securing opportunities for members.",
    milestones: [
      "Annual UOS Innovation Demo Day & Exhibition",
      "Student venture showcase for external angel/client networks",
      "Talent scout portfolio review for graduating seniors",
      "Next generation leadership handover & society scaling"
    ]
  }
];
---

<section id="roadmap" class="relative py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-20">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/20 text-emerald-400 font-mono text-xs uppercase tracking-widest mb-4">
      <Milestone class="w-3.5 h-3.5 text-emerald-400" />
      <span>Execution Timeline</span>
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
      Roadmap 2026–2027
    </h2>
    <p class="text-base text-gray-400 leading-relaxed">
      A transparent, milestone-driven execution plan for establishing a permanent innovation footprint at the University of Sahiwal.
    </p>
  </div>

  <div class="relative max-w-4xl mx-auto">
    <!-- Center connecting line -->
    <div class="hidden md:block absolute left-1/2 top-4 bottom-4 -translate-x-1/2 w-0.5 bg-gradient-to-b from-emerald-500 via-teal-500 to-gray-800"></div>

    <div class="space-y-12">
      {phases.map((item, idx) => {
        const isEven = idx % 2 === 0;

        return (
          <div class={`relative flex flex-col md:flex-row items-center ${isEven ? 'md:flex-row-reverse' : ''} gap-8`}>
            <!-- Center Node Marker -->
            <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-gray-950 border-2 border-emerald-400 items-center justify-center z-10 shadow-lg shadow-emerald-500/20">
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
            </div>

            <!-- Content Card -->
            <div class={`w-full md:w-[calc(50%-2.5rem)] glass-panel p-7 rounded-3xl border border-white/5 hover:border-emerald-500/30 transition-all ${isEven ? 'md:text-left' : 'md:text-left'}`}>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-400">
                  {item.phase} • {item.timeline}
                </span>
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-950 border border-emerald-500/30 text-emerald-300">
                  {item.status}
                </span>
              </div>

              <h3 class="text-xl font-bold text-white mb-2">
                {item.title}
              </h3>

              <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-5">
                {item.focus}
              </p>

              <div class="space-y-2 border-t border-white/5 pt-4">
                {item.milestones.map((m) => (
                  <div class="flex items-start gap-2">
                    <CheckCircle2 class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5" />
                    <span class="text-xs text-gray-400 leading-snug">{m}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Empty spacing for balance on desktop -->
            <div class="hidden md:block w-[calc(50%-2.5rem)]"></div>
          </div>
        );
      })}
    </div>
  </div>
</section>
