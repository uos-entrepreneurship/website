---
const items1 = [
  "ENTREPRENEURSHIP",
  "INNOVATION",
  "TECHNOLOGY",
  "THINK. BUILD. LAUNCH.",
  "CAMPUS BUILDERS",
  "STUDENT-LED VENTURES",
  "OPEN SOURCE ECOSYSTEM",
  "UNIVERSITY OF SAHIWAL"
];

const items2 = [
  "BBA & COMMERCE",
  "COMPUTER SCIENCE",
  "DESIGN THINKING",
  "AI & MODERN TECH",
  "CLIENT ACQUISITION",
  "RAPID PROTOTYPING",
  "PRODUCT INCUBATION",
  "COMMUNITY OVER ISOLATION"
];
---

<section id="marquee" class="relative py-6 bg-gray-950/80 border-y border-white/5 overflow-hidden select-none">
  <!-- Row 1: Forward -->
  <div class="relative w-full overflow-hidden flex whitespace-nowrap mb-3">
    <div class="animate-marquee flex items-center gap-8">
      {items1.concat(items1).map((item) => (
        <div class="flex items-center gap-8">
          <span class="font-mono text-xs sm:text-sm font-semibold tracking-[0.2em] text-gray-400 uppercase hover:text-emerald-400 transition-colors">
            {item}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/60 inline-block"></span>
        </div>
      ))}
    </div>
  </div>

  <!-- Row 2: Reverse -->
  <div class="relative w-full overflow-hidden flex whitespace-nowrap">
    <div class="animate-marquee-reverse flex items-center gap-8">
      {items2.concat(items2).map((item) => (
        <div class="flex items-center gap-8">
          <span class="font-mono text-xs sm:text-sm font-medium tracking-[0.18em] text-gray-500 uppercase hover:text-cyan-400 transition-colors">
            {item}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 inline-block"></span>
        </div>
      ))}
    </div>
  </div>
</section>
